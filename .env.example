# ─── Required in all environments ───
NODE_ENV=development
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://localhost:5432/trivance_db
JWT_SECRET=change-me-to-a-secret-of-at-least-32-chars

# ─── Required in production (validated at boot, fail-fast) ───
COOKIE_SECRET=change-me-to-a-secret-of-at-least-32-chars
SITE_URL=http://localhost
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=change-me-to-a-secret-of-at-least-16-chars
COMPANY_ID=
CORS_ORIGIN=

# ─── Optional (with defaults) ───
# PORT=3001
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=trivance_db
# JSON_LIMIT=10mb
# URL_ENCODED_LIMIT=10mb
# CROSS_ORIGIN= (legacy alias for CORS_ORIGIN)

# ─── Docker compose only (not read by Node) ───
# TEST_DB_PORT=5432
# TEST_DB_NAME=trivance_db_test
